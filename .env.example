# ───────────────────────────────────────────────────────────────
# OpenCourse English City — server configuration
# Copy this file to `.env` and fill in ONE provider.
# You can also leave this empty and paste your key in the game's
# Settings screen (it stays in your browser's localStorage).
# ───────────────────────────────────────────────────────────────

# anthropic | openai | gemini | groq | openrouter | ollama | custom | mock
LLM_PROVIDER=anthropic

# Optional: override the default model of the provider
# LLM_MODEL=claude-haiku-5-5

# Keys (only the one for your provider is needed)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=

# For "custom" (any OpenAI-compatible server: LM Studio, vLLM, LocalAI...)
# or to point ollama to another machine
# LLM_BASE_URL=http://localhost:1234/v1
# LLM_API_KEY=

# Let players send their own key from the browser (each player pays for
# their own NPC conversations). Keep true for LAN parties.
ALLOW_CLIENT_KEYS=true

# ── Voices (optional) ──────────────────────────────────────────
# Natural character voices with Deepgram text-to-speech (https://deepgram.com).
# Leave empty and the game uses the browser's own voices.
DEEPGRAM_API_KEY=

PORT=8787
# 0.0.0.0 lets friends on your network join your city
HOST=0.0.0.0

# ── Docker / database ──────────────────────────────────────────
# With `docker compose up` these are set for you. Without Docker, point
# DATABASE_URL at any Postgres to keep player saves on the server
# (leave it unset and saves stay in the browser only).
# DATABASE_URL=postgres://city:city@localhost:5432/city
# POSTGRES_PASSWORD=city
# Port of the game on your machine when using Docker
# WEB_PORT=3000
# Ollama on the host, seen from inside the backend container:
# LLM_BASE_URL=http://host.docker.internal:11434/v1
