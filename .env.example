# ───────────────────────────────────────────────────────────────
# OpenCourse English City — server configuration
# Copy this file to `.env` and fill in ONE provider.
# You can also leave this empty and paste your key in the game's
# Settings screen (it stays in your browser's localStorage).
# ───────────────────────────────────────────────────────────────

# anthropic | openai | gemini | groq | openrouter | ollama | custom | mock
LLM_PROVIDER=anthropic

# Optional: override the default model of the provider
# LLM_MODEL=claude-haiku-5-5

# Keys (only the one for your provider is needed)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=

# For "custom" (any OpenAI-compatible server: LM Studio, vLLM, LocalAI...)
# or to point ollama to another machine
# LLM_BASE_URL=http://localhost:1234/v1
# LLM_API_KEY=

# Let players send their own key from the browser (each player pays for
# their own NPC conversations). Keep true for LAN parties.
ALLOW_CLIENT_KEYS=true

PORT=8787
# 0.0.0.0 lets friends on your network join your city
HOST=0.0.0.0
