{
  "name": "open-course-english-game",
  "version": "0.1.0",
  "description": "Open-source open-world (GTA-style) English learning game with AI NPCs and online players. Bring your own API key.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n server,client -c blue,green \"node --watch server/index.js\" \"vite\"",
    "build": "vite build",
    "start": "vite build && node server/index.js",
    "serve": "node server/index.js",
    "test": "node --test test/*.test.js"
  },
  "engines": { "node": ">=18.17" },
  "dependencies": {
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "concurrently": "^9.1.0",
    "phaser": "3.90.0",
    "vite": "^6.0.0"
  }
}
